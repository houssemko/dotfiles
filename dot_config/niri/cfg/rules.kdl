    window-rule {
        geometry-corner-radius 14 // Set every window radius to 20
        clip-to-geometry true
    }

     // if you use steam you will probably like these
    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }

    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }
    
    blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.2
}

// Enable blur for general application windows without xray
window-rule {
    background-effect {
        blur true
        xray false
    }
}

// Enable blur for Noctalia shell layers (bars, panels, docks, launchers)
layer-rule {
    match namespace="^noctalia-(background|launcher-overlay|dock)-.*$"
    background-effect {
        xray false
    }
}
