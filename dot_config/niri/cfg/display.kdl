// ────────────── Output Configuration ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

// External display (Samsung SyncMaster) — set as primary
output "DP-1" {
    mode "1600x900@59.978"
    scale 1
    position x=0 y=0
    transform "normal"
}

// Laptop display — off when external display is connected
output "eDP-1" {
    off
}
