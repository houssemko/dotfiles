// Display & Monitor Output Configuration
// Run `niri msg outputs` in a terminal to inspect connected display names.
// Uncomment and adjust for your monitor if needed:
//
// output "eDP-1" {
//     mode "1920x1080@165.000"
//     scale 1.0
//     position x=0 y=0
// }

output "eDP-1" {
    mode "1366x768@60.003"
    scale 1.0
    position x=0 y=0
    off
}

output "DP-1" {
    mode "1600x900@59.978"
    scale 1.0
    position x=0 y=0
    focus-at-startup
}
