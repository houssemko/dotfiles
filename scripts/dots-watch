#!/usr/bin/env bash
# Watch dotfiles + config dirs for changes and auto-commit+push
# Usage: dots-watch [--foreground] [--debounce N] [--no-git] <dir1> [dir2] ...

set -euo pipefail

# shellcheck source=/home/houssem/.dotfiles/scripts/dots-sync.lib.sh
source "/home/houssem/.dotfiles/scripts/dots-sync.lib.sh"

DIRS=()
FOREGROUND=false
DEBOUNCE=2
NO_GIT=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --foreground) FOREGROUND=true ;;
        --debounce)
            shift
            DEBOUNCE="${1:-2}"
            ;;
        --no-git) NO_GIT=1 ;;
        -h|--help)
            echo "Usage: dots-watch [--foreground] [--debounce N] [--no-git] <dir1> [dir2] ..."
            echo "  --foreground   Run in foreground (don't daemonize sync)"
            echo "  --debounce N   Debounce time in seconds (default: 2)"
            echo "  --no-git       Skip git commit/push, only sync configs and stow"
            exit 0
            ;;
        *) DIRS+=("$1") ;;
    esac
    shift
done

if [[ ${#DIRS[@]} -eq 0 ]]; then
    echo "Error: No directories specified" >&2
    exit 1
fi

export NO_GIT

# Initial sync
full_sync || true

INOTIFY_PID=""

# Trap to clean up inotifywait
cleanup() {
    log "Shutting down watcher..."
    [[ -n "$INOTIFY_PID" ]] && kill "$INOTIFY_PID" 2>/dev/null || true
    [[ -n "$FIFO" && -p "$FIFO" ]] && rm -f "$FIFO"
    release_lock
    exit 0
}
trap cleanup EXIT INT TERM

# Create FIFO for inotifywait output
FIFO=$(mktemp -u)
mkfifo "$FIFO"

# Watch for changes (debounced) - output to FIFO
inotifywait -qmr -e create -e modify -e delete -e move --exclude '\.git/' "${DIRS[@]}" >"$FIFO" &
INOTIFY_PID=$!

while read -r path event file; do
    log "Change detected: $path$file ($event)"
    sleep "$DEBOUNCE"
    full_sync || log "Sync failed, continuing..."
done <"$FIFO" || { release_lock; exit 1; }