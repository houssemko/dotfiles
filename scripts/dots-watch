#!/usr/bin/env bash
# Watch dotfiles + config dirs for changes and auto-commit+push
# Usage: dots-watch [--foreground] <dir1> [dir2] ...

set -euo pipefail

DIRS=("$@")
FOREGROUND=false
DOTFILES_DIR="$HOME/.dotfiles"
LOG_FILE="$DOTFILES_DIR/watcher.log"
SLEEP_PID=""

if [[ "${DIRS[0]}" == "--foreground" ]]; then
    FOREGROUND=true
    DIRS=("${DIRS[@]:1}")
fi

# Export for notify-send when run without a full X session
export DISPLAY="${DISPLAY:-:0}"
export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"

log() { echo "$1"; }

notify() { notify-send "dots" "$1" 2>/dev/null || true; }

recreate_symlinks() {
    local pkg
    for pkg_dir in "$DOTFILES_DIR"/*/; do
        [[ "$(basename "$pkg_dir")" == ".git" ]] && continue
        pkg=$(basename "$pkg_dir")
        stow -d "$DOTFILES_DIR" --target "$HOME/.config" "$pkg" 2>/dev/null || true
    done
}

sync_config_to_dotfiles() {
    local pkg src dst
    for pkg_dir in "$DOTFILES_DIR"/*/; do
        [[ "$(basename "$pkg_dir")" == ".git" ]] && continue
        pkg=$(basename "$pkg_dir")
        src="$HOME/.config/$pkg"
        dst="$DOTFILES_DIR/$pkg/.config/$pkg"
        [[ -d "$src" ]] || continue
        mkdir -p "$dst"
        cp -ru "$src/." "$dst/" 2>/dev/null || true
    done
}

git_sync_and_push() {
    git -C "$DOTFILES_DIR" add -A
    if git -C "$DOTFILES_DIR" diff --cached --quiet; then
        log "No changes to commit"
        notify "No changes to commit"
        return 0
    fi
    git -C "$DOTFILES_DIR" commit -m "update configs" >/dev/null
    if git -C "$DOTFILES_DIR" pull --rebase --autostash 2>/dev/null && \
       git -C "$DOTFILES_DIR" push 2>&1; then
        log "Configs updated and pushed"
        notify "Configs updated and pushed"
    else
        log "Commit created, push failed (run 'git pull' in $DOTFILES_DIR)"
        notify "Commit created, push failed"
        return 1
    fi
}

cleanup() {
    [[ -n "$SLEEP_PID" ]] && kill "$SLEEP_PID" 2>/dev/null || true
    exit 0
}
trap cleanup EXIT INT TERM

# Initial status check
sync_config_to_dotfiles
git_sync_and_push || true

# Watch for changes (debounced)
inotifywait -qmr -e create -e modify -e delete -e move --exclude '\.git/' "${DIRS[@]}" |
while read -r path event file; do
    [[ -n "$SLEEP_PID" ]] && kill "$SLEEP_PID" 2>/dev/null && wait "$SLEEP_PID" 2>/dev/null || true

    if [[ "$FOREGROUND" == "true" ]]; then
        sleep 2
        sync_config_to_dotfiles
        git_sync_and_push
    else
        (
            sleep 2
            sync_config_to_dotfiles
            git_sync_and_push
        ) >> "$LOG_FILE" 2>&1 &
        SLEEP_PID=$!
    fi
done