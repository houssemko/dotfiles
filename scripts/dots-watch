#!/usr/bin/env bash
# Watch dotfiles + config dirs for changes and auto-commit+push
# Usage: dots-watch [--foreground] <dir1> [dir2] ...

set -euo pipefail

# shellcheck source=/home/houssem/.dotfiles/scripts/dots-sync.lib.sh
source "/home/houssem/.dotfiles/scripts/dots-sync.lib.sh"

DIRS=("$@")
FOREGROUND=false
INOTIFY_PID=""

if [[ "${DIRS[0]}" == "--foreground" ]]; then
    FOREGROUND=true
    DIRS=("${DIRS[@]:1}")
fi

# Initial sync
full_sync || true

# Trap to clean up inotifywait
cleanup() {
    log "Shutting down watcher..."
    [[ -n "$INOTIFY_PID" ]] && kill "$INOTIFY_PID" 2>/dev/null || true
    release_lock
    exit 0
}
trap cleanup EXIT INT TERM

# Watch for changes (debounced)
inotifywait -qmr -e create -e modify -e delete -e move --exclude '\.git/' "${DIRS[@]}" &
INOTIFY_PID=$!

while read -r path event file; do
    log "Change detected: $path$file ($event)"
    sleep 2
    full_sync || log "Sync failed, continuing..."
done < <(wait $INOTIFY_PID)