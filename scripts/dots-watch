#!/usr/bin/env bash
# Watch dotfiles + config dirs for changes and auto-commit+push
# Usage: dots-watch <dir1> [dir2] [dir3] ...

DIRS=("$@")
SLEEP_PID=""
export DISPLAY="${DISPLAY:-:0}"
export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"

sync_config_to_dotfiles() {
    for pkg_dir in "$HOME"/.dotfiles/*/; do
        pkg=$(basename "$pkg_dir")
        src="$HOME/.config/$pkg"
        dst="$HOME/.dotfiles/$pkg/.config/$pkg"
        [[ -d "$src" ]] || continue
        # Copy only real files (skip symlinks and caches)
        find "$src" -type f ! -type l -not -path '*/cache/*' -not -path '*/__pycache__/*' | while read -r f; do
            rel="${f#$src/}"
            mkdir -p "$dst/$(dirname "$rel")"
            cp -u "$f" "$dst/$rel" 2>/dev/null
        done
        # Copy new directories
        find "$src" -type d ! -type l | while read -r d; do
            rel="${d#$src/}"
            [[ "$rel" == "$d" ]] && continue
            mkdir -p "$dst/$rel" 2>/dev/null
        done
    done
}

# Initial status check
sync_config_to_dotfiles
git -C "$HOME/.dotfiles" add -A
if git -C "$HOME/.dotfiles" diff --cached --quiet; then
    echo "No changes to commit"
    notify-send "dots" "No changes to commit" 2>/dev/null
else
    git -C "$HOME/.dotfiles" commit -m "update configs"
    git -C "$HOME/.dotfiles" push
    echo "Configs updated and pushed"
    notify-send "dots" "Configs updated and pushed" 2>/dev/null
fi

cleanup() {
    [[ -n "$SLEEP_PID" ]] && kill "$SLEEP_PID" 2>/dev/null
    exit 0
}
trap cleanup EXIT INT TERM

inotifywait -qmr -e create -e modify -e delete -e move --exclude '\.git/' "${DIRS[@]}" |
while read -r path event file; do
    [[ -n "$SLEEP_PID" ]] && kill "$SLEEP_PID" 2>/dev/null && wait "$SLEEP_PID" 2>/dev/null

    (
        sleep 2
        sync_config_to_dotfiles
        git -C "$HOME/.dotfiles" add -A
        if git -C "$HOME/.dotfiles" diff --cached --quiet; then
            echo "No changes to commit"
            notify-send "dots" "No changes to commit" 2>/dev/null
        else
            git -C "$HOME/.dotfiles" commit -m "update configs"
            if git -C "$HOME/.dotfiles" push; then
                echo "Configs updated and pushed"
                notify-send "dots" "Configs updated and pushed" 2>/dev/null
            else
                echo "Commit created, push failed (run 'git pull' in ~/.dotfiles)"
                notify-send "dots" "Commit created, push failed" 2>/dev/null
            fi
        fi
    ) >> "$HOME/.dotfiles/watcher.log" 2>&1 &
    SLEEP_PID=$!
done
