#!/usr/bin/env bash
# Single-shot dotfiles sync
# Usage: dots-sync [--dry-run] [--verbose] [--no-git]

set -euo pipefail

DRY_RUN=0
VERBOSE=0
NO_GIT=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1 ;;
        --verbose) VERBOSE=1 ;;
        --no-git) NO_GIT=1 ;;
        -h|--help)
            echo "Usage: dots-sync [--dry-run] [--verbose] [--no-git]"
            echo "  --dry-run   Show what would be done without making changes"
            echo "  --verbose   Show detailed output"
            echo "  --no-git    Skip git commit/push, only sync configs and stow"
            exit 0
            ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
    shift
done

export DRY_RUN VERBOSE NO_GIT

# shellcheck source=/home/houssem/.dotfiles/scripts/dots-sync.lib.sh
source "/home/houssem/.dotfiles/scripts/dots-sync.lib.sh"

full_sync